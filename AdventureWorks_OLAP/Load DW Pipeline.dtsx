              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT C.CustomerID, C.Title, C.FirstName, C.MiddleName, C.LastName, C.CompanyName, C.EmailAddress AS Email, C.Phone, A.Address AS OfficeAddress, A.City, A.State, A.Country
FROM [dbo].[Customer] C
LEFT JOIN [dbo].[Customer_Address] CA ON C.CustomerID = CA.CustomerID AND CA.AddressType = 'Main Office'
LEFT JOIN [dbo].[Address] A ON CA.AddressID = A.AddressID</property>
